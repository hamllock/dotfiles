/* SwayOSD: liquid glass, matching the quickshell popups and top bar.
   Greyscale like the rest of the shell, so no matugen colours are used. */

/* Make the base GTK window completely transparent */
window {
    background: transparent;
}

window#osd {
    background: transparent;
    border: none;
    box-shadow: none;
}

/* liquid glass (hypr/config/hyprliquid.conf, swayosd_glass): the glass takes its shape
   from this box's alpha, so no shadow or border; border-radius must match corner_radius.
   Near-clear fill: the glass tint does the colouring */
window#osd #container,
window#osd-container {
    background-color: rgba(16, 16, 16, 0.06);
    border: none;
    border-radius: 32px;
    padding: 16px 20px;
    margin: 16px;
    min-width: 250px;
    box-shadow: none;
}

/* The background "track" of the progress bar */
trough {
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 99px;
    border: none;
    min-height: 8px;
    min-width: 200px;
}

/* The filled part of the progress bar */
progress {
    background-color: rgba(255, 255, 255, 0.9);
    background-image: none;
    border-radius: 99px;
    border: none;
    min-height: 8px;

    /* GTK warning fix */
    margin: 0px;
    padding: 0px;
    min-width: 0px;
}

/* Text Label styling */
label {
    color: rgba(255, 255, 255, 0.92);
    font-family: "SF Pro Display";
    font-weight: 600;
    font-size: 16px;
    margin-bottom: 8px;
}

/* Icon styling */
image {
    color: rgba(255, 255, 255, 0.92);
    -gtk-icon-style: symbolic;
}
