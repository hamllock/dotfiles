/* import theme modules */
@import url('https://refact0r.github.io/midnight-discord/build/midnight.css');

body {
    --font: '';
    --code-font: '';
    font-weight: 400;

    --gap: 12px;
    --divider-thickness: 4px;
    --border-thickness: 1px;

    --animations: on;
    --list-item-transition: 0.2s ease;
    --dms-icon-svg-transition: 0.4s ease;
    --border-hover-transition: 0.2s ease;

    --top-bar-height: var(--gap);
    --top-bar-button-position: titlebar;
    --top-bar-title-position: off;
    --subtle-top-bar-title: off;

    --custom-window-controls: on;
    --window-control-size: 14px;

    --custom-dms-icon: custom;
    --dms-icon-svg-url: url('https://refact0r.github.io/midnight-discord/assets/Font_Awesome_5_solid_moon.svg');
    --dms-icon-svg-size: 90%;
    --dms-icon-color-before: var(--icon-subtle);
    --dms-icon-color-after: var(--white);
    --custom-dms-background: off;
    --dms-background-image-url: url('');
    --dms-background-image-size: cover;
    --dms-background-color: linear-gradient(70deg, var(--blue-2), var(--purple-2), var(--red-2));

    --background-image: off;
    --background-image-url: url('');

    --transparency-tweaks: on;
    --remove-bg-layer: off; /* set to on + enable vesktop window transparency to see your desktop wallpaper */
    --panel-blur: on;
    --blur-amount: 12px;
    --bg-floating: hsla({{colors.surface_container.default.hue}}, {{colors.surface_container.default.saturation}}%, {{colors.surface_container.default.lightness}}%, 0.85);

    --custom-chatbar: separated;
    --chatbar-height: 56px;

    --small-user-panel: on;
}

:root {
    --colors: on;

    --text-0: {{colors.on_primary.default.hex}};
    --text-1: {{colors.on_surface.default.hex}};
    --text-2: hsla({{colors.on_surface.default.hue}}, {{colors.on_surface.default.saturation}}%, {{colors.on_surface.default.lightness}}%, 0.82);
    --text-3: hsla({{colors.on_surface.default.hue}}, {{colors.on_surface.default.saturation}}%, {{colors.on_surface.default.lightness}}%, 0.65);
    --text-4: hsla({{colors.on_surface.default.hue}}, {{colors.on_surface.default.saturation}}%, {{colors.on_surface.default.lightness}}%, 0.45);
    --text-5: hsla({{colors.on_surface.default.hue}}, {{colors.on_surface.default.saturation}}%, {{colors.on_surface.default.lightness}}%, 0.3);

    --bg-1: hsla({{colors.surface_container_highest.default.hue}}, {{colors.surface_container_highest.default.saturation}}%, {{colors.surface_container_highest.default.lightness}}%, 0.6);
    --bg-2: hsla({{colors.surface_container_high.default.hue}}, {{colors.surface_container_high.default.saturation}}%, {{colors.surface_container_high.default.lightness}}%, 0.6);
    --bg-3: hsla({{colors.surface_container.default.hue}}, {{colors.surface_container.default.saturation}}%, {{colors.surface_container.default.lightness}}%, 0.6);
    --bg-4: hsla({{colors.surface_container_lowest.default.hue}}, {{colors.surface_container_lowest.default.saturation}}%, {{colors.surface_container_lowest.default.lightness}}%, 0.6);
    --hover: hsla({{colors.on_surface.default.hue}}, {{colors.on_surface.default.saturation}}%, {{colors.on_surface.default.lightness}}%, 0.1);
    --active: hsla({{colors.on_surface.default.hue}}, {{colors.on_surface.default.saturation}}%, {{colors.on_surface.default.lightness}}%, 0.18);
    --active-2: hsla({{colors.on_surface.default.hue}}, {{colors.on_surface.default.saturation}}%, {{colors.on_surface.default.lightness}}%, 0.28);
    --message-hover: hsla({{colors.on_surface.default.hue}}, {{colors.on_surface.default.saturation}}%, {{colors.on_surface.default.lightness}}%, 0.05);

    --accent-1: var(--blue-1);
    --accent-2: var(--blue-2);
    --accent-3: var(--blue-3);
    --accent-4: var(--blue-4);
    --accent-5: var(--blue-5);
    --accent-new: var(--accent-2);
    --mention: linear-gradient(to right, color-mix(in hsl, var(--accent-2), transparent 90%) 40%, transparent);
    --mention-hover: linear-gradient(to right, color-mix(in hsl, var(--accent-2), transparent 95%) 40%, transparent);
    --reply: linear-gradient(to right, color-mix(in hsl, var(--text-3), transparent 90%) 40%, transparent);
    --reply-hover: linear-gradient(to right, color-mix(in hsl, var(--text-3), transparent 95%) 40%, transparent);

    --online: var(--green-2);
    --dnd: var(--red-2);
    --idle: var(--yellow-2);
    --streaming: var(--purple-2);
    --offline: var(--text-4);

    --border-light: hsla({{colors.outline.default.hue}}, {{colors.outline.default.saturation}}%, {{colors.outline.default.lightness}}%, 0.15);
    --border: hsla({{colors.outline.default.hue}}, {{colors.outline.default.saturation}}%, {{colors.outline.default.lightness}}%, 0.25);
    --border-hover: hsla({{colors.outline.default.hue}}, {{colors.outline.default.saturation}}%, {{colors.outline.default.lightness}}%, 0.4);
    --button-border: hsla(0, 0%, 100%, 0.1);

    --red-1: hsla({{colors.error.default.hue}}, {{colors.error.default.saturation}}%, {{colors.error.default.lightness}}%, 1);
    --red-2: hsla({{colors.error.default.hue}}, {{colors.error.default.saturation}}%, calc({{colors.error.default.lightness}}% - 5%), 1);
    --red-3: hsla({{colors.error.default.hue}}, {{colors.error.default.saturation}}%, calc({{colors.error.default.lightness}}% - 10%), 1);
    --red-4: hsla({{colors.error.default.hue}}, {{colors.error.default.saturation}}%, calc({{colors.error.default.lightness}}% - 15%), 1);
    --red-5: hsla({{colors.error.default.hue}}, {{colors.error.default.saturation}}%, calc({{colors.error.default.lightness}}% - 20%), 1);

    --green-1: hsla(150, 55%, 70%, 1);
    --green-2: hsla(150, 55%, 65%, 1);
    --green-3: hsla(150, 50%, 55%, 1);
    --green-4: hsla(150, 50%, 50%, 1);
    --green-5: hsla(150, 45%, 40%, 1);

    --blue-1: hsla({{colors.primary.default.hue}}, {{colors.primary.default.saturation}}%, {{colors.primary.default.lightness}}%, 1);
    --blue-2: hsla({{colors.primary.default.hue}}, {{colors.primary.default.saturation}}%, calc({{colors.primary.default.lightness}}% - 5%), 1);
    --blue-3: hsla({{colors.primary.default.hue}}, {{colors.primary.default.saturation}}%, calc({{colors.primary.default.lightness}}% - 10%), 1);
    --blue-4: hsla({{colors.primary.default.hue}}, {{colors.primary.default.saturation}}%, calc({{colors.primary.default.lightness}}% - 15%), 1);
    --blue-5: hsla({{colors.primary.default.hue}}, {{colors.primary.default.saturation}}%, calc({{colors.primary.default.lightness}}% - 20%), 1);

    --yellow-1: hsla(60, 60%, 70%, 1);
    --yellow-2: hsla(60, 60%, 65%, 1);
    --yellow-3: hsla(60, 50%, 55%, 1);
    --yellow-4: hsla(60, 50%, 50%, 1);
    --yellow-5: hsla(60, 40%, 40%, 1);

    --purple-1: hsla({{colors.secondary.default.hue}}, {{colors.secondary.default.saturation}}%, {{colors.secondary.default.lightness}}%, 1);
    --purple-2: hsla({{colors.secondary.default.hue}}, {{colors.secondary.default.saturation}}%, calc({{colors.secondary.default.lightness}}% - 5%), 1);
    --purple-3: hsla({{colors.secondary.default.hue}}, {{colors.secondary.default.saturation}}%, calc({{colors.secondary.default.lightness}}% - 10%), 1);
    --purple-4: hsla({{colors.secondary.default.hue}}, {{colors.secondary.default.saturation}}%, calc({{colors.secondary.default.lightness}}% - 15%), 1);
    --purple-5: hsla({{colors.secondary.default.hue}}, {{colors.secondary.default.saturation}}%, calc({{colors.secondary.default.lightness}}% - 20%), 1);
}

.iconBadge__650eb svg {
    color: {{colors.primary.default.hex}} !important;
}

