[fill]
symbol = ' '

[character]
format = "$symbol "
success_symbol = "[◎](bold italic fg:{{colors.primary_fixed_dim.default.hex}})"
error_symbol = "[○](italic fg:{{colors.tertiary.default.hex}})"
vimcmd_symbol = "[■](italic fg:{{colors.green.default.hex}})"
vimcmd_replace_one_symbol = "◌"
vimcmd_replace_symbol = "□"
vimcmd_visual_symbol = "▼"

[env_var.VIMSHELL]
format = "[$env_value]($style)"
style = "italic fg:{{colors.green.default.hex}}"

[sudo]
format = "[$symbol]($style)"
style = "bold italic fg:{{colors.tertiary.default.hex}}"
symbol = "⋈┈"
disabled = false

[username]
style_user = "bold italic fg:{{colors.primary_fixed_dim.default.hex}}"
style_root = "bold italic fg:{{colors.tertiary.default.hex}}"
format = "[⭘ $user]($style) "
disabled = false
show_always = false

[directory]
home_symbol = "⌂"
truncation_length = 2
truncation_symbol = "□ "
read_only = " ◈"
use_os_path_sep = true
style = "italic fg:{{colors.primary.default.hex}}"
format = '[$path]($style)[$read_only]($read_only_style)'
repo_root_style = "bold fg:{{colors.primary.default.hex}}"
repo_root_format = '[$before_root_path]($before_repo_root_style)[$repo_root]($repo_root_style)[$path]($style)[$read_only]($read_only_style) [△](bold fg:{{colors.primary_fixed.default.hex}})'

[cmd_duration]
min_time = 0
format = "[◄ $duration ](italic fg:{{colors.on_surface_variant.default.hex}})"

[jobs]
format = "[$symbol$number]($style) "
style = "fg:{{colors.on_surface_variant.default.hex}}"
symbol = "[▶](italic fg:{{colors.primary.default.hex}})"

[localip]
ssh_only = true
format = " ◯[$localipv4](bold fg:{{colors.tertiary.default.hex}})"
disabled = false

[time]
disabled = false
format = "[ $time]($style)"
time_format = "%R"
utc_time_offset = "local"
style = "italic fg:{{colors.outline.default.hex}}"

[battery]
format = "[ $percentage $symbol]($style)"
full_symbol = "█"
charging_symbol = "[↑](italic bold fg:{{colors.green.default.hex}})"
discharging_symbol = "↓"
unknown_symbol = "░"
empty_symbol = "▃"

[[battery.display]]
threshold = 20
style = "italic bold fg:{{colors.error.default.hex}}"

[[battery.display]]
threshold = 60
style = "italic fg:{{colors.tertiary.default.hex}}"

[[battery.display]]
threshold = 70
style = "italic fg:{{colors.primary_fixed_dim.default.hex}}"

[git_branch]
format = " [$branch(:$remote_branch)]($style)"
symbol = "[△](bold italic fg:{{colors.primary_fixed.default.hex}})"
style = "italic fg:{{colors.primary_fixed.default.hex}}"
truncation_symbol = "⋯"
truncation_length = 11
ignore_branches = ["main", "master"]
only_attached = true

[git_metrics]
format = '([▴$added]($added_style))([▿$deleted]($deleted_style))'
added_style = "italic fg:{{colors.green.default.hex}}"
deleted_style = "italic fg:{{colors.error.default.hex}}"
ignore_submodules = true
disabled = false

[git_status]
style = "bold italic fg:{{colors.primary_fixed.default.hex}}"
format = "([⎪$ahead_behind$staged$modified$untracked$renamed$deleted$conflicted$stashed⎥]($style))"
conflicted = "[◪◦](italic fg:{{colors.tertiary.default.hex}})"
ahead = "[▴│[${count}](bold fg:{{colors.on_surface.default.hex}})│](italic fg:{{colors.green.default.hex}})"
behind = "[▿│[${count}](bold fg:{{colors.on_surface.default.hex}})│](italic fg:{{colors.error.default.hex}})"
diverged = "[◇ ▴┤[${ahead_count}](fg:{{colors.on_surface.default.hex}})│▿┤[${behind_count}](fg:{{colors.on_surface.default.hex}})│](italic fg:{{colors.tertiary.default.hex}})"
untracked = "[◌◦](italic fg:{{colors.primary_fixed_dim.default.hex}})"
stashed = "[◃◈](italic fg:{{colors.on_surface_variant.default.hex}})"
modified = "[●◦](italic fg:{{colors.tertiary_fixed_dim.default.hex}})"
staged = "[▪┤[$count](bold fg:{{colors.on_surface.default.hex}})│](italic fg:{{colors.secondary_fixed_dim.default.hex}})"
renamed = "[◎◦](italic fg:{{colors.primary.default.hex}})"
deleted = "[✕](italic fg:{{colors.error.default.hex}})"

[deno]
format = " [deno](italic) [∫ $version](bold fg:{{colors.green.default.hex}})"
version_format = "${raw}"

[lua]
format = " [lua](italic) [${symbol}${version}]($style)"
version_format = "${raw}"
symbol = "⨀ "
style = "bold fg:{{colors.primary_fixed_dim.default.hex}}"

[nodejs]
format = " [node](italic) [◫ ($version)](bold fg:{{colors.green.default.hex}})"
version_format = "${raw}"
detect_files = ["package-lock.json", "yarn.lock"]
detect_folders = ["node_modules"]
detect_extensions = []

[python]
format = " [py](italic) [${symbol}${version}]($style)"
symbol = "[⌉](bold fg:{{colors.primary_fixed.default.hex}})⌊ "
version_format = "${raw}"
style = "bold fg:{{colors.primary_fixed_dim.default.hex}}"

[ruby]
format = " [rb](italic) [${symbol}${version}]($style)"
symbol = "◆ "
version_format = "${raw}"
style = "bold fg:{{colors.error.default.hex}}"

[rust]
format = " [rs](italic) [$symbol$version]($style)"
symbol = "⊃ "
version_format = "${raw}"
style = "bold fg:{{colors.error.default.hex}}"

[package]
format = " [pkg](italic dimmed) [$symbol$version]($style)"
version_format = "${raw}"
symbol = "◨ "
style = "italic bold fg:{{colors.primary_fixed_dim.default.hex}}"

[swift]
format = " [sw](italic) [${symbol}${version}]($style)"
symbol = "◁ "
style = "bold fg:{{colors.error.default.hex}}"
version_format = "${raw}"

[aws]
disabled = true
format = " [aws](italic) [$symbol $profile $region]($style)"
style = "bold fg:{{colors.primary.default.hex}}"
symbol = "▲ "

[buf]
symbol = "■ "
format = " [buf](italic) [$symbol $version $buf_version]($style)"

[c]
symbol = "ℂ "
format = " [$symbol($version(-$name))]($style)"

[conda]
symbol = "◯ "
format = " conda [$symbol$environment]($style)"

[dart]
symbol = "◁◅ "
format = " dart [$symbol($version )]($style)"

[docker_context]
symbol = "◧ "
format = " docker [$symbol$context]($style)"

[elixir]
symbol = "△ "
format = " exs [$symbol $version OTP $otp_version ]($style)"

[elm]
symbol = "◩ "
format = " elm [$symbol($version )]($style)"

[golang]
symbol = "∩ "
format = " go [$symbol($version )]($style)"

[haskell]
symbol = "❯λ "
format = " hs [$symbol($version )]($style)"

[java]
symbol = "∪ "
format = " java [${symbol}(${version} )]($style)"

[julia]
symbol = "◎ "
format = " jl [$symbol($version )]($style)"

[memory_usage]
symbol = "▪▫▪ "
format = " mem [${ram}( ${swap})]($style)"

[nim]
symbol = "▴▲▴ "
format = " nim [$symbol($version )]($style)"

[nix_shell]
style = "bold italic fg:{{colors.primary.default.hex}}"
symbol = "✶"
format = '[$symbol nix⎪$state⎪]($style) [$name](italic fg:{{colors.outline.default.hex}})'
impure_msg = "[⌽](bold fg:{{colors.error.default.hex}})"
